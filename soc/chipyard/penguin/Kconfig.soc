# SPDX-License-Identifier: Apache-2.0

config SOC_PENGUIN
	bool
	help
	  Chipyard "penguin" SoC: Shuttle core(s) with a Saturn RVV unit.

config SOC
	default "penguin" if SOC_PENGUIN

# Zephyr's arch/riscv/Kconfig.isa has lost the Zba/Zbb/Zbs symbols (its Zbs help
# text is glued onto ZVFBFMIN), yet cmake/compiler/gcc/target_riscv.cmake still
# tests CONFIG_RISCV_ISA_EXT_ZBA/ZBB/ZBS to build -march. Declaring them here
# (a Kconfig symbol may be declared more than once) makes that cmake code work
# without touching the Zephyr fork.
config RISCV_ISA_EXT_ZBA
	bool
config RISCV_ISA_EXT_ZBB
	bool
config RISCV_ISA_EXT_ZBS
	bool
