# SPDX-License-Identifier: Apache-2.0

if SOC_PENGUIN

# Saturn VLEN = 256 (DLEN 128, ELEN 64): WithShuttleVectorUnit(256, 128, ...)
# in the EE290SimConfig family (read from the course tapeout repo; high confidence).
# The config name "GENV256D128ShuttleConfig" once cited here does not exist in
# the lab Chipyard tree; "penguin" == EE290SimConfig is itself INFERRED.
# The per-thread vector save area is sized from this at compile time; soc.c
# panics at boot if the hardware vlenb is larger.
config RISCV_VECTOR_MAX_LEN
	default 256

# Eager V save/restore is the validated path on Saturn (see
# RISCV_V_DECOUPLED_LAZY help in arch/riscv/Kconfig.isa).
config RISCV_ISA_EXT_V_LAZY
	default n

# mtime / timebase = 500 kHz. WithPeripheryBusFrequency(500) also calls
# WithTimebase(500 * 1e3) = 500000 Hz (chipyard ClockingFragments.scala:91-96,
# confidence H for the number; the pbus/1000 divider that generates the tick
# is rocket-chip code, INFERRED). This is the Kconfig source of truth; the DT
# /cpus timebase-frequency repeats it per board and soc.c has a BUILD_ASSERT
# that fails the build if the two disagree.
config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 50000 if CHIPYARD_FPGA_TA		# WithFPGAFrequency(50) -> WithTimebase(50e3), TA Configs.scala:88; generated DTS (EE290VCU118Config .dts:17) timebase-frequency = <50000>
	default 1000000 if CHIPYARD_FPGA_EMULATION	# DTSTimebase = 1e6 in the Chipyard VCU118 flow
	default 500000

# The SiFive UART is clocked by the 500 MHz PBUS, so its input clock is
# SYS_CLOCK_HW_CYCLES_PER_SEC * RTC_CLOCK_DIVIDER_VALUE = 500 kHz * 1000
# = 500 MHz (soc.h). Derived, confidence M (divider value INFERRED).
config RTC_CLOCK_DIVIDER_VALUE
	default 1000 if CHIPYARD_FPGA_TA		# 50 MHz PBUS / 50 kHz mtime = 1000 -> UART clock 50 MHz; generated DTS pbus_clock = <50000000> (.dts:114-119), serial clocks = <&pbus_clock> (.dts:132)
	default CHIPYARD_FPGA_PBUS_MHZ if CHIPYARD_FPGA_EMULATION	# 1 MHz mtime * N = N MHz PBUS
	default 1000

config RISCV_MACHINE_TIMER_SYSTEM_CLOCK_DIVIDER
	default 0

config RISCV_SOC_INTERRUPT_INIT
	default y

# PLIC: keep in sync with riscv,ndev in penguin.dtsi. The taped-out PLIC has
# ONE source (UART = source 1, RC Plic.scala:113; riscv,ndev = 1).
# Zephyr indexes the second-level ISR table by the PLIC source id, so the
# table needs ids 0 and 1: MAX_IRQ_PER_AGGREGATOR = 2, and
# NUM_IRQS = 2ND_LVL_ISR_TBL_OFFSET (12 machine-level lines) + 2 = 14.
# 2ND_LEVEL_INTERRUPT_BITS = 2 holds (source + 1) = 2.
config 2ND_LVL_ISR_TBL_OFFSET
	default 12

config 2ND_LVL_INTR_00_OFFSET
	default 11

config 2ND_LEVEL_INTERRUPT_BITS
	default 2

config MAX_IRQ_PER_AGGREGATOR
	default 2

config NUM_IRQS
	default 14

# No PMP: Shuttle is built with nPMPs = 0 (shuttle common/Parameters.scala:56,
# 68-69, confidence H), so CONFIG_RISCV_PMP stays off (board defconfig) and
# PMP_SLOTS (which only exists under RISCV_PMP) is not set here.

config TICKET_SPINLOCKS
	default y

endif # SOC_PENGUIN
