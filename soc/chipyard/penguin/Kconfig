config SOC_PENGUIN
	select RISCV
	# RISCV_PRIVILEGED means "machine-level CSRs/traps" (mstatus, mtvec, ...),
	# which Zephyr needs. The hardware has S/U modes and Sv39 (useVM = true makes
	# rocket-chip set hasSupervisorMode, tapeout repo RC/tile/Core.scala:64), but
	# Zephyr runs in M-mode here. No PMP (nPMPs = 0, shuttle
	# common/Parameters.scala:56), so keep RISCV_PMP and USERSPACE off.
	select RISCV_PRIVILEGED
	select RISCV_HAS_PLIC
	select RISCV_SOC_HAS_GP_RELATIVE_ADDRESSING
	select ATOMIC_OPERATIONS_BUILTIN
	select INCLUDE_RESET_VECTOR
	select 64BIT
	select RISCV_ISA_RV64I
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_A
	select RISCV_ISA_EXT_F
	select RISCV_ISA_EXT_D
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_ZICSR
	select RISCV_ISA_EXT_ZIFENCEI
	select RISCV_ISA_EXT_V
	# Extensions below are confirmed in Shuttle/Saturn Parameters (core parameters read
	# from the course tapeout repo, high confidence; that the
	# chip is EE290TapeoutConfig, T/README.md:69-83). Whatever is selected here ends up in
	# GCC's -march (Zephyr cmake) AND in Spike's --isa (cmake/spike.cmake).
	#  - Zfh:    FPU minFLen = 16 (scalar half precision)
	#  - Zba/Zbb/Zbs: useZba/useZbb/useZbs = true
	#  - Zvfh:   Saturn vfh = true (vector FP16 arithmetic)
	select RISCV_ISA_EXT_ZFH
	select RISCV_ISA_EXT_ZBA
	select RISCV_ISA_EXT_ZBB
	select RISCV_ISA_EXT_ZBS
	select RISCV_ISA_EXT_ZVFH
	# NOT selected:
	#  - Zicntr: Shuttle has basic counters (haveBasicCounters = true) but the
	#    chip's riscv,isa string omits zicntr (rocket-chip comments it out:
	#    "rdtime[h] is not implemented", BaseTile.scala:136-139), so do not
	#    rely on rdtime; read mtime over MMIO. Zephyr's
	#    target_riscv.cmake emits "_zicntr" and then "v" with no underscore
	#    ("..._zicntrv_..."), which GCC rejects. Left out of -march (harmless:
	#    csrr of cycle/time/instret assembles regardless).
	# BF16 (confirmed by the project owner 2026-10-09 that
	# Shuttle+Saturn support BF16). The generator side: Saturn's "mx" build
	# (mxParams) adds zvfofp8min, zfbfmin, zvfbfmin, zvfbfa to riscv,isa
	# (tapeout-chipyard generators/saturn/src/main/scala/common/Parameters.scala
	# :55-60 and :374-377). What this port does with them:
	#  - Zvfbfmin: SELECTED. vfwcvtbf16 / vfncvtbf16 (BF16 <-> FP32 vector
	#    conversions). GCC 14.3 and binutils 2.43 in SDK 1.0-beta1 accept it.
	#  - Zfbfmin (scalar fcvt.s.bf16 / fcvt.bf16.s) and Zvfbfa (BF16 vector
	#    arithmetic via vtype.altfmt): the fork has the symbol for Zfbfmin, but
	#    GCC 14.3 rejects "-march=..._zfbfmin" ("unsupported standard
	#    extension"), and neither fork nor GCC 14 knows Zvfbfa. Selecting
	#    ZFBFMIN would therefore break every build, so these two are given to
	#    Spike only (SPIKE_ISA_EXTRA in boards/chipyard/penguin/board.cmake).
	#    Our former BF16 test (removed) used plain Zvfbfmin mnemonics and
	#    sets vtype.altfmt (Zvfbfa) by hand with vsetvl, since GCC 14.3 has no
	#    zvfbfa; XNNPACK uses ".option arch" and the Atlas team .insn macros.
	#  - Zvfofp8min: not selected anywhere. Spike has it, GCC 14.3 does not,
	#    and nothing in this port uses FP8 yet.
	# (The fork's Kconfig.isa help text for ZVFBFMIN has the Zbs help text glued
	# on its end; that is cosmetic, the symbol and the -march text are fine.)
	select RISCV_ISA_EXT_ZVFBFMIN
	# NOT selected (hardware has it, but this is not worth the risk):
	#  - Zvbb: no Zephyr symbol and not needed by the kernel.
	select CPU_HAS_FPU_DOUBLE_PRECISION
	imply XIP

# ---- Whole-SoC FPGA emulation (board variant "vcu118") ----------------------

config CHIPYARD_FPGA_EMULATION
	bool "Whole SoC emulated on an FPGA (VCU118), UART console, no HTIF"
	depends on SOC_PENGUIN
	help
	  Selected by the board variant chipyard_penguin/penguin/vcu118. Changes
	  the clock facts (1 MHz mtime, UART input clock = the bus clock below)
	  to the generic Chipyard VCU118 flow (fpga/src/main/scala/vcu118/
	  Configs.scala). Values are assumptions for Penguin: the real
	  Penguin-on-VCU118 config is not available.

config CHIPYARD_FPGA_PBUS_MHZ
	int "Peripheral bus (UART input) clock in MHz"
	default 100
	range 1 1000
	depends on CHIPYARD_FPGA_EMULATION
	help
	  Frequency of the PBUS that clocks the SiFive UART. The generic
	  Chipyard VCU118 flow builds with WithFPGAFrequency(N) for N in
	  25, 50, 75 or 100 (default 100, WithVCU118Tweaks). Must match the
	  bitstream or the UART baud rate is wrong (garbled console).
	  zephyr uses SIFIVE_PERIPHERAL_CLOCK_FREQUENCY =
	  SYS_CLOCK_HW_CYCLES_PER_SEC * RTC_CLOCK_DIVIDER_VALUE (soc.h), and
	  RTC_CLOCK_DIVIDER_VALUE is set to this number.

config CHIPYARD_FPGA_TA
	bool "Real Penguin RTL on a VCU118 as the TA's EE290VCU118Config (HTIF console)"
	depends on SOC_PENGUIN
	help
	  Selected by the board variant chipyard_penguin/penguin/vcu118_ta.
	  Changes only the clock facts: every bus is 50 MHz and the timebase
	  (mtime) is 50 kHz, from WithFPGAFrequency(50) in bringup-chipyard
	  245f2a9d fpga/src/main/scala/vcu118/Configs.scala:88,112-119 and
	  ClockingFragments.scala:92-93. The console stays HTIF through
	  UART-TSI (unlike CHIPYARD_FPGA_EMULATION). CONFIRMED against the DTS
	  generated for EE290VCU118Config (bringup-chipyard 245f2a9d, 2026-10-09,
	  fpga/generated-src/chipyard.fpga.vcu118.VCU118FPGATestHarness.
	  EE290VCU118Config/*.dts): timebase-frequency = <50000> (line 17) and
	  every bus clock-frequency = <50000000> (lines 65-129).

config CHIPYARD_SIM_EXIT_HTIF
	bool "chipyard_sim_exit() ends the run via HTIF tohost"
	default y if UART_HTIF
	depends on SOC_PENGUIN
	help
	  Needs an HTIF host (Spike, uart_tsi, the Chipyard testharness). When
	  off (FPGA with no host), chipyard_sim_exit() prints
	  "*** EXIT <code> ***" on the console and halts in a wfi loop.
