#
# Variant "vcu118_ta": real Penguin RTL (EE290SimConfig) on a VCU118, as the TA's
# EE290VCU118Config (bringup-chipyard 245f2a9d). See the DTS header.
#
# NOTE: Zephyr loads ONLY this file for the variant (it does not layer it on
# chipyard_penguin_defconfig), so the common lines below are a copy of the base
# board's. Keep them in sync when editing chipyard_penguin_defconfig.

# --- variant-specific -------------------------------------------------------
# The switch the SoC layer keys off: 50 kHz mtime, 50 MHz UART clock.
CONFIG_CHIPYARD_FPGA_TA=y

# Console stays HTIF (through the UART-TSI host), like the base board. The
# peripheral UART at 0x6400_0000 is status="disabled" in the DTS.
CONFIG_UART_HTIF=y
CONFIG_UART_SIFIVE_PORT_0=n

# --- copied from chipyard_penguin_defconfig ---------------------------------
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_EARLY_CONSOLE=y
CONFIG_REBOOT=y

CONFIG_XIP=n
CONFIG_RISCV_PMP=n
CONFIG_PINCTRL=n

CONFIG_FPU=y
CONFIG_FPU_SHARING=y
CONFIG_FLOAT_HARD=y

# mtime is 50 kHz here (SYS_CLOCK_HW_CYCLES_PER_SEC=50000, soc Kconfig.defconfig).
# The tick rate must divide it. 1000 ticks/s = 1 ms = exactly 50 mtime counts
# per tick (one count = 20 us). The base board's 10000 would leave only 5 counts
# (100 us) per tick, so timer reprogramming/ISR cost would dominate on the
# 50 MHz core, and a 1 ms tick is the usual Zephyr granularity for k_msleep().
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
CONFIG_TIMING_FUNCTIONS=y

CONFIG_STACK_SENTINEL=y
CONFIG_IDLE_STACK_SIZE=1024
CONFIG_SPEED_OPTIMIZATIONS=y
