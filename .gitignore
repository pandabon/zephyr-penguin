# Local notes are not tracked; README.md is the documentation.
# (Add new docs to README.md, or un-ignore a specific path below.)
*.md
*.rst
!/README.md

# Python bytecode and local build output (the workspace builds in ../build, but a stray in-tree build must not show up as untracked)
__pycache__/
/build/

# docs/ is a local, untracked folder
/docs/
